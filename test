function farmerVision(player)
    if not player then return end

    local data = player:FindFirstChild("DataFolder")
    if not data then return end

    local cash = data:FindFirstChild("Currency")
    if not cash then return end

    -- Tracking
    local lastCash = cash.Value
    local lastGainTime = tick()
    local gainIntervals = {} -- store last 10 intervals
    local farmingDetected = false

    -- Helper: push with max size
    local function push(list, value, max)
        table.insert(list, value)
        if #list > max then
            table.remove(list, 1)
        end
    end

    -- Track cash gain intervals
    cash.Changed:Connect(function()
        if cash.Value > lastCash then
            local now = tick()
            local interval = now - lastGainTime

            push(gainIntervals, interval, 10)

            lastGainTime = now
            lastCash = cash.Value
        end
    end)

    -- Farming detection loop
    task.spawn(function()
        while true do
            task.wait(2)

            if #gainIntervals < 5 then
                continue
            end

            -- Count fast intervals (<= 10 seconds)
            local fast = 0
            for _, interval in ipairs(gainIntervals) do
                if interval <= 10 then
                    fast += 1
                end
            end

            -- Farming logic:
            -- If 70%+ of intervals are fast → farming
            local ratio = fast / #gainIntervals

            if ratio >= 1 then
                if not farmingDetected then
                    if farming and autoHopEnabled then
                        farmingDetected = true
                        autoHopPlayer()
                    end
                end
            else
                farmingDetected = false
            end
        end
    end)
end


