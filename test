function getHopState()
    local userId = game.Players.LocalPlayer.UserId
    local hopFile = Fname .. "/hop_" .. userId .. ".txt"
    if isfile(hopFile) then
        local data = readfile(hopFile)
        local parts = {}
        for part in data:gmatch("[^\n]+") do
            table.insert(parts, part)
        end
        if #parts >= 4 then
            return {
                hopping = parts[1] == "true",
                timestamp = tonumber(parts[2]) or 0,
                date = parts[3] or "",
                autoStart = parts[4] == "true"  -- Read the autoStart flag
            }
        elseif #parts >= 3 then
            -- Backward compatibility
            return {
                hopping = parts[1] == "true",
                timestamp = tonumber(parts[2]) or 0,
                date = parts[3] or "",
                autoStart = true  -- Default to true for old saves
            }
        end
    end
    return {hopping = false, timestamp = 0, date = "", autoStart = true}
end

