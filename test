function calculateProfit()
    local overAllProfit = 0
    
    -- Safety check: if collectedDrops is nil or empty, return 0
    if not collectedDrops or #collectedDrops == 0 then
        return 0
    end
    
    for _, drop in ipairs(collectedDrops) do
        -- Safety: skip if drop is nil or invalid
        if drop and drop.Parent then
            local textLabel = nil
            
            -- Method 1: Try to find BillboardGui
            local billboard = drop:FindFirstChild("BillboardGui") or drop:FindFirstChildOfClass("BillboardGui")
            if billboard then
                textLabel = billboard:FindFirstChild("TextLabel") or billboard:FindFirstChildOfClass("TextLabel")
            end
            
            -- Method 2: Search all descendants for TextLabel
            if not textLabel then
                for _, child in ipairs(drop:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        textLabel = child
                        break
                    end
                end
            end
            
            -- Extract number from text
            if textLabel and textLabel.Text then
                local cleanText = textLabel.Text:gsub("[^%d]", "")  -- Remove non-digits
                if cleanText and cleanText ~= "" then
                    local numberPrice = tonumber(cleanText)
                    if numberPrice and numberPrice > 0 then
                        overAllProfit = overAllProfit + numberPrice
                    end
                end
            end
        end
    end
    
    return overAllProfit
end

