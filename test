    local speed = fast and 0.10 or 0.5
    local HidenMode = DropCollectionType == "Hiden"
    collectingDrops = true

    -- Save originals so we can restore on exit
    local savedPlatformStand = hum and hum.PlatformStand
    local savedBase = BASE_SPEED
    local savedMax  = MAX_SPEED

    if hum then
        hum.PlatformStand = true
    end

    -- ⭐ Clear stale follow state from BreakATM/BreakVault
    FollowTargetPartState = false
    FollowTargetPart = nil
    FollowTargetPartOffset = nil

    plrCurrentStatus = "Collecting"
    plrCurrentStatusColor = Color3.fromRGB(30,95,164)

    -- ⭐ Single exit path — always restores everything
    local function finish()
        collectingDrops = false
        FollowTargetPartState = false
        FollowTargetPart = nil
        FollowTargetPartOffset = nil
        BASE_SPEED = savedBase
        MAX_SPEED  = savedMax
        creditedDrops = {}

        if hum then
            hum.PlatformStand = savedPlatformStand or false
        end

        if farming then
            plrCurrentStatus = "Farming"
            plrCurrentStatusColor = Color3.fromRGB(30,188,96)
        else
            plrCurrentStatus = "Idle"
            plrCurrentStatusColor = Color3.fromRGB(220, 184, 35)
        end
    end

    local KO = LocalPlayerData.char:FindFirstChild("BodyEffects")
    if KO then
        KO = KO:FindFirstChild("K.O")
        if KO then
            KO.Changed:Connect(function()
                if KO.Value then finish() end
            end)
        end
    end

    local drops = AllNearbyDHC()

    for _, drop in ipairs(drops) do
        if not (farming and currentTargetType("DHC")) then finish() return end
        if cancelDrops then cancelDrops = false; finish() return end
        if not drop or not drop.Parent then continue end
        if creditedDrops[drop] then continue end

        local detector = drop:FindFirstChild("ClickDetector")
        if not detector then continue end

        local dropValue = getDropValue(drop) or 0
        local initialDist = (drop.Position - LocalPlayerData.root.Position).Magnitude

        ---------------------------------------------------------------
        -- POSITIONING
        ---------------------------------------------------------------
        if tPart then
            if initialDist >= 50 then
                FollowTargetPartState = false
                FollowTargetPart = nil
                FollowTargetPartOffset = nil
                LocalPlayerData.root.CFrame = CFrame.new(tPart.Position)
                task.wait(0.1)
            end

            FollowTargetPart = tPart
            FollowTargetPartOffset = Vector3.new(0, -1, 0)
            FollowTargetPartState = true

        elseif HidenMode then
            -- ⭐ Hiden mode: -5 below drop
            if initialDist >= 50 then
                FollowTargetPartState = false
                FollowTargetPart = nil
                FollowTargetPartOffset = nil
                LocalPlayerData.root.CFrame = CFrame.new(drop.Position + Vector3.new(0, -5, 0))
                task.wait(0.1)
            else
                FollowTargetPart = drop
                FollowTargetPartOffset = Vector3.new(0, -5, 0)
                FollowTargetPartState = true

                local arriveTimeout = tick() + 10
                while drop and drop.Parent do
                    if not (farming and currentTargetType("DHC")) then
                        FollowTargetPartState = false
                        FollowTargetPart = nil
                        FollowTargetPartOffset = nil
                        break
                    end
                    if tick() > arriveTimeout then break end
                    if not drop then break end
                    if (drop.Position - LocalPlayerData.root.Position).Magnitude <= 8 then break end
                    task.wait(0.05)
                end
            end
        else
            -- Exposed mode: simple teleport above
            if initialDist >= 50 then
                FollowTargetPartState = false
                FollowTargetPart = nil
                FollowTargetPartOffset = nil
                LocalPlayerData.root.CFrame = CFrame.new(drop.Position + Vector3.new(0, 3, 0))
                task.wait(0.1)
            else
                LocalPlayerData.root.CFrame = CFrame.new(drop.Position + Vector3.new(0, 3, 0))
                task.wait(0.1)
            end
        end

        ---------------------------------------------------------------
        -- CLICK LOOP
        ---------------------------------------------------------------
        local timeout = tick() + 15
        while drop and drop.Parent and farming do
            if not (farming and currentTargetType("DHC")) then finish() return end
            if tick() > timeout then break end

            if not drop.Parent then
                FollowTargetPartState = false
                FollowTargetPart = nil
                FollowTargetPartOffset = nil
                break
            end

            local currentDetector = drop:FindFirstChild("ClickDetector")
            if not currentDetector then
                FollowTargetPartState = false
                FollowTargetPart = nil
                FollowTargetPartOffset = nil
                break
            end

            local dist = (drop.Position - LocalPlayerData.root.Position).Magnitude

            if HidenMode and not tPart then
                BASE_SPEED = 25
                MAX_SPEED  = 55
                FollowTargetPart = drop
                FollowTargetPartOffset = Vector3.new(0, -5, 0)
                FollowTargetPartState = true
            elseif not tPart and dist > 8 then
                FollowTargetPartState = false
                LocalPlayerData.root.CFrame = CFrame.new(drop.Position + Vector3.new(0, 3, 0))
                task.wait(0.05)
            end

            if type(fireclickdetector) == "function" then
                fireclickdetector(currentDetector)
            else
                break
            end

            task.wait(speed)
        end

        FollowTargetPartState = false
        FollowTargetPart = nil
        FollowTargetPartOffset = nil

        if not creditedDrops[drop] then
            creditedDrops[drop] = true
            Profit = Profit + dropValue
        end
    end

    finish()
end]]
