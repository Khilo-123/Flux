        tostring(ATMsBroken)
    )

    task.wait()

    -- Load flagged servers (this will auto-clear if 5 minutes have passed)
    local flagged = getFlaggedServers()

    -- Server finder with multiple fallback strategies
    local function fetchServers()
        local HttpService = game:GetService("HttpService")
        
        local endpoints = {
            "https://games.roblox.com/v1/games/"..placeid.."/servers/Public?sortOrder=Asc&limit=100",
            "https://games.roblox.com/v1/games/"..placeid.."/servers/Public?sortOrder=Asc&limit=50",
            "https://games.roblox.com/v1/games/"..placeid.."/servers/Public?sortOrder=Desc&limit=100",
            "https://games.roblox.com/v1/games/"..placeid.."/servers/Public?limit=100"
        }
        
        for _, endpoint in ipairs(endpoints) do
            local success, data = pcall(function()
                local response = game:HttpGet(endpoint)
                return HttpService:JSONDecode(response)
            end)
            
            if success and data and data.data and #data.data > 0 then
                --("✅ Successfully fetched servers from endpoint")
                return data
            else
                --("⚠️ Failed to fetch from endpoint, trying next...")
                task.wait(0.5)
            end
        end
        
        return nil
    end
    
    -- Try to fetch servers with retries
    local data = nil
    local retries = 0
    local maxRetries = 1
    
    while not data and retries < maxRetries do
        retries = retries + 1
        --("📡 Fetching servers attempt " .. retries .. "/" .. maxRetries)
        data = fetchServers()
        if not data then
            task.wait(1 * retries)
        end
    end
    
    local serverList = {}
    local smallestCount = math.huge
    local smallestID = nil
    local maxPlayers = 40 -- Max players per server (adjust as needed)
    
    if data and data.data then
        for _, server in ipairs(data.data) do
            -- ⭐ FIX: Skip full servers and servers with too many players
            local isFull = server.playing >= server.maxPlayers or server.playing >= maxPlayers
            
            if server.id ~= game.JobId 
               and not flagged[server.id]  -- Now checks if server is flagged (auto-clears if expired)
               and not isFull
               and server.playing < server.maxPlayers then
                
                if server.playing < smallestCount then
                    smallestCount = server.playing
                    smallestID = server.id
                end
                table.insert(serverList, server.id)
            else
                if isFull then
                    --("⛔ Skipping full server: " .. server.id .. " (" .. server.playing .. "/" .. server.maxPlayers .. ")")
                elseif flagged[server.id] then
                    --("🚫 Skipping flagged server: " .. server.id .. " (flagged at " .. flagged[server.id].date .. ")")
                end
            end
        end
    end

    -- Choose based on JoinServerBy
    if JoinServerBy == "Smallest" then
        chosenServer = smallestID
        if chosenServer then
            --("✅ Joining smallest server:", smallestCount, "players")
        end
    elseif JoinServerBy == "Random" then
        if #serverList > 0 then
            chosenServer = serverList[math.random(1, #serverList)]
            --("✅ Joining random server with", #serverList, "servers available")
        end
    else
        autoHopping = false
        return
    end

    -- If no server found, try fallback methods
    if not chosenServer then
        --("⚠️ No suitable server found, trying fallback methods...")
        
        -- Method 1: Clear flagged and try one more time with less strict filtering
        clearFlaggedServers()
        task.wait(1)
        
        -- Try to get ANY server (including ones with more players)
        local fallbackData = nil
        local fallbackRetries = 0
        
        while not fallbackData and fallbackRetries < 3 do
            fallbackRetries = fallbackRetries + 1
            fallbackData = fetchServers()
            task.wait(0.5)
        end
        
        if fallbackData and fallbackData.data then
            local fallbackServers = {}
            for _, server in ipairs(fallbackData.data) do
                -- ⭐ FALLBACK: Allow servers with up to maxPlayers, but not completely full
                if server.id ~= game.JobId 
                   and server.playing < server.maxPlayers
                   and server.playing < maxPlayers then
                    table.insert(fallbackServers, server.id)
                end
            end
            
            if #fallbackServers > 0 then
                chosenServer = fallbackServers[math.random(1, #fallbackServers)]
                --("⚠️ FORCE JOINING server (fallback): " .. chosenServer)
                notife({Text="Joining available server...", state=3})
            end
        end
        
        -- ULTIMATE FALLBACK: If still no server, wait and retry
        if not chosenServer then
            --("❌ No available servers found, waiting and retrying...")
            notife({Text="No available servers, retrying...", state=3})
            task.wait(5)
            autoHopping = false
            autoHopPlayer(true, autoStart) -- Retry with same autoStart value
            return
        end
    end

    -- SAFETY CHECK: If chosenServer is STILL nil, wait and retry
    if not chosenServer then
        --("⚠️ CRITICAL: chosenServer is nil, retrying...")
        notife({Text="Server selection failed, retrying...", state=3})
        task.wait(3)
        autoHopping = false
        autoHopPlayer(true, autoStart)
        return
    end

    -- Flag the server (if different from current)
    if chosenServer and chosenServer ~= game.JobId then
        flagServer(chosenServer)
        --("🚩 Flagged server: " .. chosenServer)
    elseif chosenServer == game.JobId then
        --("🔄 Rejoining current server to reset state")
        clearFlaggedServers()
    end

    -- Teleport
    task.wait(0.1)
    --("🚀 Teleporting to: " .. (chosenServer or "unknown"))
    
    -- SAFETY CHECK before teleport
    if chosenServer then
        game:GetService("TeleportService"):TeleportToPlaceInstance(placeid, chosenServer, game.Players.LocalPlayer)
    else
        --("❌ CRITICAL: Cannot teleport - chosenServer is nil!")
        notife({Text="Teleport failed - no server found", state=2})
        autoHopping = false
        return
    end
    
    task.wait(5)
    autoHopping = false
end

