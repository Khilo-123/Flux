local sessionID = math.random(1,9999) + ((t.month * t.sec) / t.hour)

public.FluxModule[sessionID] = {
	
}

players = game:GetService("Players")

localPlayer = players.LocalPlayer
localCharacter = localPlayer.Character
localRoot = localCharacter:FindFirstChild("HumanoidRootPart")

function module.UpdatePlayerData(newCharacter)
	localCharacter = newCharacter
	localRoot = newCharacter:FindFirstChild("HumanoidRootPart")
end

expandHitboxSession = {activated=false,rootSize=nil,current=0}
function module.ExpandHitbox(size)
	expandHitboxSession.activated=true
	expandHitboxSession.current += 1
	local newCurrent = expandHitboxSession.current
	local finalSize
	if size then
		finalSize = Vector3.new(size,size,size)
	end
	
	local function expand(plr)
		local plrChar = plr.Character
		local root = plrChar:FindFirstChild("HumanoidRootPart")
		expandHitboxSession.rootSize = root.Size
		task.wait()
		root.CanCollide = false
		
		root.Transparency = .5
		if finalSize then
			root.Size = finalSize
		else
			root.Size = Vector3.new(10,10,10)
		end
	end
	
	for _,plr in pairs(players:GetChildren()) do
		if plr and plr:IsA("Player") and plr.Character and plr ~= localPlayer then
			expand(plr)
			task.wait(.001)
		end
	end
	players.PlayerAdded:Connect(function(plr)
		
		plr.CharacterAdded:Connect(function()
			if expandHitboxSession.activated and expandHitboxSession.current == newCurrent then
				expand(plr)

			end
		end)
	end)
end
function module.ExpandHitbox_()
	if not expandHitboxSession.activated then return end
	expandHitboxSession.activated = false
	task.wait()
	for _, plr in pairs(players:GetChildren()) do
		if plr and plr:IsA("Player") and plr.Character and plr ~= localPlayer then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			root.Size = expandHitboxSession.rootSize
			root.CanCollide = true
		end
	end
end

function module.listPlayers(includeLocal)
	local result = {}
	local function register(plr,index)
		local data = {}
		data.index = index
		data.instance = plr
		data.name = plr.Name
		data.character = plr.Character
		data.root = plr.Character:FindFirstChild("HumanoidRootPart")
		data.humanoid = data.character:FindFirstChild("Humanoid")
		data.displayName = data.humanoid.DisplayName
		data.accountAge = plr.AccountAge
		
		table.insert(result,data)
	end
	for i,plr in pairs(players:GetChildren()) do
		if plr and plr:IsA("Player") then
			if plr ~= localPlayer then
				register(plr,i)
			elseif plr == localPlayer and includeLocal then
				register(plr,i)
			end
		end
	end
	return result
end

function module.getPlayerType(target)
	local tType = "?"
	if target:IsA("Model") and target:FindFirstChild("Humanoid") and players:GetPlayerFromCharacter(target) then tType = "c" end
	if target:IsA("Player") and target.Character then tType="p"end
	return tType
end

function module.getPosition(target)
	local tType = module.getPlayerType(target)
	if tType == "c" then
		local root = target:FindFirstChild("HumanoidRootPart")
		return root.Position
	elseif tType == "p" then
		local char = target.Character
		local root = char:FindFirstChild("HumanoidRootPart")
		return root.Position
	end
end

return module
