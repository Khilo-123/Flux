function serializeList(tbl)
    if type(tbl) ~= "table" then
        return "{}"
    end
    
    local parts = {}
    for _, item in ipairs(tbl) do
        if type(item) == "string" then
            table.insert(parts, '"' .. tostring(item) .. '"')
        else
            table.insert(parts, tostring(item))
        end
    end
    return "{" .. table.concat(parts, ",") .. "}"
end






local function ParseConfig(str)
    local result = {}
    --("=== PARSE CONFIG START ===")
    --("Raw config string:", str)

    -- Remove outer braces
    str = str:match("{(.*)}")
    if not str then
        --("ERROR: No content found inside braces")
        return result
    end
    
    --("Content after removing braces:", str)

    -- Split by lines first (your config is line-separated)
    for line in str:gmatch("[^\n]+") do
        --("Processing line:", line)
        
        -- Match key and value - using (.+) to capture everything after =
        local key, value = line:match("%['(.-)'%]%s*=%s*(.+)$")
        if key and value then
            --("  Found key: '" .. key .. "'")
            --("  Found value: '" .. value .. "'")
            
            -- Trim spaces and remove trailing comma
            value = value:match("^%s*(.-)%s*$")
            if value:sub(-1) == "," then
                value = value:sub(1, -2)
                value = value:match("^%s*(.-)%s*$")
            end
            
            -- Handle arrays like {ATMs,Vaults} or {"ATMs","Vaults"}
            if value:match("^{.*}$") then
                local inner = value:match("{(.*)}")
                local t = {}
                
                if inner and inner ~= "" then
                    -- Handle both quoted and unquoted items
                    for item in inner:gmatch("[^,]+") do
                        item = item:match("^%s*(.-)%s*$")
                        -- Remove quotes if present
                        local unquoted = item:match('^"(.-)"$')
                        if unquoted then
                            item = unquoted
                        end
                        if item ~= "" then
                            table.insert(t, item)
                        end
                    end
                end
                
                result[key] = t
                --("  Set array:", key, "=", table.concat(t, ", "))
                
            -- Handle booleans
            elseif value == "false" or value == "\"false\"" then
                result[key] = false
                --("  Set boolean false:", key)
            elseif value == "true" or value == "\"true\"" then
                result[key] = true
                --("  Set boolean true:", key)
                
            -- Handle numbers
            elseif tonumber(value) then
                result[key] = tonumber(value)
                --("  Set number:", key, "=", result[key])
                
            -- Handle strings
            elseif value:match("^\"(.-)\"$") then
                result[key] = value:match("^\"(.-)\"$")
                --("  Set string:", key, "=", result[key])
                
            -- Handle raw strings without quotes
            else
                result[key] = value
                --("  Set raw:", key, "=", value)
            end
        else
            --("  WARNING: Could not parse line:", line)
        end
    end
    
    --("=== PARSE CONFIG END ===")
    --("Final result:")
    for k, v in pairs(result) do
        if type(v) == "table" then
            --("  " .. k .. " = {" .. table.concat(v, ", ") .. "}")
        else
            --("  " .. k .. " = " .. tostring(v))
        end
    end
    
    return result
end

