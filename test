local function fuzzyMatch(str, pattern)
    str = str:lower()
    pattern = pattern:lower()

    -- Split pattern into words
    local parts = {}
    for word in pattern:gmatch("%S+") do
        table.insert(parts, word)
    end

    -- Search each word in order
    local lastPos = 1
    for _, word in ipairs(parts) do
        local s, e = str:find(word, lastPos, true)
        if not s then
            return false
        end
        lastPos = e + 1
    end

    return true
end

local function objectWithPrefixExists(prefix)
    local folder = Shop
    if not folder then
        return nil
    end

    for _, obj in ipairs(folder:GetChildren()) do
        if fuzzyMatch(obj.Name, prefix) then
            return obj
        end
    end

    return nil
end

function FindItem(name)
    if objectWithPrefixExists(name) then
        return objectWithPrefixExists(name)
    end
    return nil
end

