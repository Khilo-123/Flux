local function checkKey(key)
    -- Validate key input
    if not key or key == "" or key == "none" then
        return false, "No key provided"
    end

    -- Pick the best HTTP request function available in this executor
    local requestFunc = syn and syn.request
        or http and http.request
        or http_request
        or request

    if not requestFunc then
        return false, "No HTTP request function available"
    end

    local HttpService = game:GetService("HttpService")

    -- Fetch a larger page so we actually see all keys.
    -- If your account ever exceeds this, we'd need to page through `pagination.totalPages`.
    local url = JNKIE_BASE_URL .. "/api/v2/keys?limit=100"

    if JNKIE_SERVICE_ID then
        url = url .. "&service_id=" .. tostring(JNKIE_SERVICE_ID)
    end

    local payload = {
        Url = url,
        Method = "GET",
        Headers = {
            ["Authorization"] = "Bearer " .. JNKIE_API_TOKEN,
            ["Accept"]        = "*/*",
        },
    }

    local ok, response = pcall(requestFunc, payload)
    if not ok then
        return false, "Request failed: " .. tostring(response)
    end

    local statusCode = response.StatusCode or response.Status or response.status or 0
    local body       = response.Body or response.body or response.Data or ""

    if statusCode == 200 then
        local decoded
        local decodeOk = pcall(function()
            decoded = HttpService:JSONDecode(body)
        end)

        if not decodeOk or type(decoded) ~= "table" then
            return false, "Failed to decode response"
        end

        local keys = decoded.keys
        if type(keys) ~= "table" or #keys == 0 then
            return false, "Key not found (no keys returned)"
        end

        -- Find the exact match
        local matchedKey = nil
        for _, k in ipairs(keys) do
            if k.key_value == key then
                matchedKey = k
                break
            end
        end

        if not matchedKey then
            return false, "Key not found (checked " .. #keys .. " keys)"
        end

        if matchedKey.is_invalidated == true then
            return false, "Key has been invalidated"
        end

        if matchedKey.expires_at then
            local okTime, expiry = pcall(function()
                return DateTime.fromIsoDate(matchedKey.expires_at).UnixTimestamp
            end)
            if okTime and expiry and os.time() > expiry then
                return false, "Key has expired"
            end
        end

        return true, matchedKey, JNKIE_API_TOKEN

    elseif statusCode == 400 then
        return false, "Invalid request"
    elseif statusCode == 401 then
        return false, "Authentication failed - Invalid or missing API token"
    elseif statusCode == 403 then
        return false, "Forbidden - plan or abuse rule blocked the lookup"
    elseif statusCode == 404 then
        return false, "Key not found"
    elseif statusCode == 429 then
        return false, "Rate limited - slow down"
    else
        return false, "API error: " .. tostring(statusCode) .. " | " .. tostring(body)
    end
end

