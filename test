                            -- Layer 2: Threats
                            local plrModel = Services.Players:GetPlayerFromCharacter(targetPlayer)
                            if ThreatList[plrModel] then
                                threatsDetected += 1
                            end

                            -- Layer 3: Weapons
                            local harmlessTools = {
                                "TipJar",
                                "[Wallet]",
                                "[Phone]",
                                "[Key]",
                                "[LockPicker]",
                                "[Surgeon Mask]"
                            }

                            for _, object in pairs(targetPlayer:GetChildren()) do
                                if object:IsA("Tool") then
                                    if not table.find(harmlessTools, object.Name) then
                                        table.insert(targetWeapons, object.Name)
                                    end
                                end
                            end
                            for _, object in pairs(plrModel.Backpack:GetChildren()) do
                                if object:IsA("Tool") then
                                    if not table.find(harmlessTools, object.Name) then
                                        table.insert(targetWeapons, object.Name)
                                    end
                                end
                            end
                        end
                    end
                end

                profile["Player Count"] = nearbyPlayersCount
                profile["Weapons Count"] = #targetWeapons
                profile["Threats Detected"] = threatsDetected

                profile["Threat Score"] = nearbyPlayersCount + #targetWeapons + threatsDetected

                profile["ATM"] = atm

                table.insert(ATMs, profile)
            end
        end
    end

    closestWinnerATMx = math.huge
    winnerATMx = nil

