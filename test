local module = {}
public = {}
public.FluxModule = {}

local sessionID = math.random(1,9999) + ((t.month * t.sec) / t.hour)

public.FluxModule[sessionID] = {
	
}

players = game:GetService("Players")

localPlayer = players.LocalPlayer
localCharacter = localPlayer.Character
localRoot = localCharacter:FindFirstChild("HumanoidRootPart")

function module.UpdatePlayerData(newCharacter)
	localCharacter = newCharacter
	localRoot = newCharacter:FindFirstChild("HumanoidRootPart")
end

expandHitboxSession = {activated=false,rootSize=nil,current=0}
function module.ExpandHitbox(size)
	expandHitboxSession.activated=true
	expandHitboxSession.current += 1
	local newCurrent = expandHitboxSession.current
	
	local function expand(plr)
		local plrChar = plr.Character
		local root = plrChar:FindFirstChild("HumanoidRootPart")
		expandHitboxSession.rootSize = root.Size
		task.wait()
		root.Size = Vector3.new(size,size,size) or Vector3.new(10,10,10)
		root.Transparency = .5
	end
	
	for _,plr in pairs(players:GetChildren()) do
		if plr and plr:IsA("Player") and plr.Character and plr ~= localPlayer then
			expand(plr)
		end
	end
	players.PlayerAdded:Connect(function(plr)
		if expandHitboxSession.activated and expandHitboxSession.current == newCurrent then
			expand(plr)
			
		end
	end)
end
function module.ExpandHitbox_()
	if not expandHitboxSession.activated then return end
	expandHitboxSession.activated = false
	task.wait()
	for _, plr in pairs(players:GetChildren()) do
		if plr and plr:IsA("Player") and plr.Character and plr ~= localPlayer then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			root.Size = expandHitboxSession.rootSize
		end
	end
end

return module
