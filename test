local function restart(mySession)
    if farming and mySession == currentSessionId then
        farmWanteds()
        return
    end
end

function farmWanteds()
    currentSessionId += 1
    local mySession = currentSessionId

    task.spawn(function()
        cleanup()

        unequipAll()
        Noclip = true

        ---------------------------------------------------------
        -- ITEM CHECKS (AUTO‑RESTART BEFORE RETURN)
        ---------------------------------------------------------

        if AttackMethod ~= "[DrumGun]" and not LocalPlayerData.plr.Backpack:FindFirstChild("[BrownBag]") then
            PurchaseItem("[BrownBag]", 1)
            restart(mySession)
            return
        end

        if AttackMethod == "[Knife]" and not LocalPlayerData.plr.Backpack:FindFirstChild("[Knife]") then
            PurchaseItem("[Knife]", 1)
            restart(mySession)
            return
        end

        if AttackMethod == "[DrumGun]" and not LocalPlayerData.plr.Backpack:FindFirstChild("[DrumGun]") then
            PurchaseItem("[Drumgun]")
            PurchaseItem("100 [Drum", 4)
            restart(mySession)
            return
        end

        ---------------------------------------------------------
        -- TARGET SELECTION
        ---------------------------------------------------------

        if not currentTarget then
            local players = Services.Players:GetPlayers()
            if #players == 0 then
                restart(mySession)
                return
            end
            currentTarget = players[math.random(1, #players)]
        end

        local TChar = currentTarget.Character
        if not TChar then restart(mySession) return end

        local TBody = TChar:FindFirstChild("BodyEffects")
        local TRoot = TChar:FindFirstChild("HumanoidRootPart")
        if not TBody or not TRoot then restart(mySession) return end

        if TBody["K.O"].Value == true then
            restart(mySession)
            return
        end

        ---------------------------------------------------------
        -- FOLLOW SETUP
        ---------------------------------------------------------

        FollowTargetPart = TRoot
        FollowTargetPartOffset = Vector3.new(0,2,4.5)
        FollowTargetPartState = true

        LocalPlayerData.root.AssemblyLinearVelocity = Vector3.new(0,0,0)

        task.spawn(function()
            while farming and mySession == currentSessionId do
                local direction = (TRoot.Position - LocalPlayerData.root.Position).Unit
                LocalPlayerData.root.CFrame = CFrame.new(LocalPlayerData.root.Position, LocalPlayerData.root.Position + direction)
                task.wait()
            end
        end)

        ---------------------------------------------------------
        -- MOVE UNTIL CLOSE
        ---------------------------------------------------------

        while farming and mySession == currentSessionId and (TRoot.Position - LocalPlayerData.root.Position).Magnitude >= 4.6 do
            task.wait()
        end

        ---------------------------------------------------------
        -- ATTACHMENTS (GUARANTEED NON‑NIL)
        ---------------------------------------------------------

        atFollower = Instance.new("Attachment")
        atFollower.Parent = LocalPlayerData.root
        atFollower.Position = Vector3.new(0, 0, -2)

        atPlayer = Instance.new("Attachment")
        atPlayer.Parent = TRoot

        alignPos = Instance.new("AlignPosition")
        alignPos.Attachment0 = atFollower
        alignPos.Attachment1 = atPlayer
        alignPos.MaxForce = 1e9
        alignPos.Responsiveness = 1
        alignPos.RigidityEnabled = false
        alignPos.Parent = LocalPlayerData.root

        alignOri = Instance.new("AlignOrientation")
        alignOri.Attachment0 = atFollower
        alignOri.Attachment1 = atPlayer
        alignOri.MaxTorque = 1e9
        alignOri.Responsiveness = 1
        alignOri.RigidityEnabled = false
        alignOri.Parent = LocalPlayerData.root

        ---------------------------------------------------------
        -- BROWNBAG CHECK
        ---------------------------------------------------------

        if AttackMethod ~= "[DrumGun]" then
            local socks = LocalPlayerData.plr.Backpack:FindFirstChild("[BrownBag]")
            socks.Parent = LocalPlayerData.char
            socks:Activate()
            task.wait(1)

            if not TChar:FindFirstChild("Christmas_Sock") then
                cleanup()
                restart(mySession)
                return
            end
        end

        --("Going for it")

        ---------------------------------------------------------
        -- ATTACK METHODS
        ---------------------------------------------------------

        if AttackMethod == "Combat" then
            unequipAll()
            local tool = LocalPlayerData.plr.Backpack:FindFirstChild("Combat")
            tool.Parent = LocalPlayerData.char
            task.wait(.1)

            while farming and mySession == currentSessionId and not TBody["K.O"].Value do
                LocalPlayerData.root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                tool:Activate()
                task.wait()
            end

        elseif AttackMethod == "[Knife]" then
            unequipAll()
            local tool = LocalPlayerData.plr.Backpack:FindFirstChild("[Knife]")

            while not tool and farming and mySession == currentSessionId do
                PurchaseItem("[Knife]", 1)
                tool = LocalPlayerData.plr.Backpack:FindFirstChild("[Knife]")
                task.wait(1)
            end

            tool.Parent = LocalPlayerData.char
            task.wait(.1)

            while farming and mySession == currentSessionId and not TBody["K.O"].Value do
                tool:Activate()
                tool:Deactivate()
                task.wait()
            end

        elseif AttackMethod == "[DrumGun]" then
            unequipAll()
            local tool = LocalPlayerData.plr.Backpack:FindFirstChild("[DrumGun]")

            while not tool and farming and mySession == currentSessionId do
                PurchaseItem("[Drumgun]", 1)
                PurchaseItem("100 [Drum", 4)
                tool = LocalPlayerData.plr.Backpack:FindFirstChild("[DrumGun]")
                task.wait(1)
            end

            tool.Parent = LocalPlayerData.char
            task.wait(.1)

            while farming and mySession == currentSessionId and not TBody["K.O"].Value do
                if not TChar:FindFirstChild("ForceField") then
                    --shoot(tool, TChar:FindFirstChild("Head"))
                    reload(tool)
                    task.wait(.3)
                end
                task.wait()
            end
        end

        ---------------------------------------------------------
        -- STOMP PHASE
        ---------------------------------------------------------

        cleanup()

        FollowTargetPart = TChar:FindFirstChild("UpperTorso")
        FollowTargetPartOffset = Vector3.new(0,3,0)
        FollowTargetPartState = true

        while farming and mySession == currentSessionId and not TBody["Dead"].Value do
            MainEvent:FireServer("Stomp")
            task.wait(1)
        end

        ---------------------------------------------------------
        -- END
        ---------------------------------------------------------

        cleanup()
        currentTarget = nil

        restart(mySession)
        return
    end)
