currentDropFarmID = 0

function dropFarm()
    local dropAmount = 0

    currentDropFarmID += 1
    local dropSessionID = currentDropFarmID
    if PaidPlan then
        dropAmount = 20000
    else
        dropAmount = 8000
    end
    task.wait()
    
    while farming do
        if not currentTargetType("Drop DHC") then
            stop()
            task.wait()
            lib.ChangeCheck:Fire("check.enabled", farming)
            return
        end
        if currentDropFarmID ~= dropSessionID  then
            return
        end
        -- Check if player is dead/KO
        if LocalPlayerData.BodyEffects["K.O"].Value or 
           LocalPlayerData.BodyEffects["Dead"].Value or 
           (LocalPlayerData.char.Humanoid.Health <= 10 and not LocalPlayerData.BodyEffects["K.O"].Value) or 
           not farming then
            notife({
                Text=farming and "Dropping got Interrupted, Stopping." or nil,
                state=3
            })
            stop()
            task.wait()
            lib.ChangeCheck:Fire("check.enabled", farming)
            return
        end

        local data = LocalPlayerData.plr:FindFirstChild("DataFolder")
        if not data then return end

        local cash = data:FindFirstChild("Currency")
        if not cash then return end

        local currentMoney = cash.Value
        local targetMoney = currentMoney - dropAmount
        local attempts = 0
        local maxAttempts = 10
        local dropped = false

        -- Keep dropping until we reach the target amount or hit max attempts
        while not dropped and attempts < maxAttempts do
            -- Update current money each loop
            currentMoney = cash.Value
            
            -- Check if we've already reached the target
            if currentMoney <= targetMoney then
                dropped = true
                break
            end
            
            -- Check if player is still alive
            if LocalPlayerData.BodyEffects["K.O"].Value or 
               LocalPlayerData.BodyEffects["Dead"].Value or 
               (LocalPlayerData.char.Humanoid.Health <= 10 and not LocalPlayerData.BodyEffects["K.O"].Value) or 
               not farming then
                notife({
                    Text=farming and "Dropping got Interrupted, Stopping." or nil,
                    state=3
                })
                stop()
            task.wait()
            lib.ChangeCheck:Fire("check.enabled", farming)
                return
            end
            
            -- Drop money
            MainEvent:FireServer("DropMoney", dropAmount)
            attempts = attempts + 1
            
            -- Wait for server to process
            task.wait(1.1)
        end

        -- Final check if we actually dropped money
        if dropped or attempts >= maxAttempts then
            local finalMoney = cash.Value
            local actualDropped = currentMoney - finalMoney
            
            if actualDropped >= 0 then
                notife({
                    Text = "Dropped $" .. (PaidPlan and "20K" or "8K").. " Successfully!",
                    state = 1
                })
            end
        end
        
        -- Wait before next drop cycle
        task.wait(10)
    end
end

