-- Path helper: accepts "name" or "name.cfg" and returns the full path
local function configPath(tConfig)
    if type(tConfig) ~= "string" or tConfig == "" then
        return nil
    end
    -- strip .cfg if the caller already included it
    tConfig = tConfig:gsub("%.cfg$", "")
    -- sanitize: only allow word chars, dash, dot
    tConfig = tConfig:gsub("[^%w_%-%.]", "_")
    return CONFIG_DIR .. "/" .. tConfig .. ".cfg", tConfig
end

