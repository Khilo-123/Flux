-- Add this near the top of your script, after the account functions
function getAltAccounts()
    local filePath = Fname .. "/accounts"
    if not isfile(filePath) then return {} end
    
    local existingData = readfile(filePath)
    local alts = {}
    
    for block in existingData:gmatch("{(.-)}") do
        local username = block:match("'Username':%s+'(.-)'")
        local userId = block:match("'UserID':%s+(%d+)")
        
        if username and userId then
            table.insert(alts, {
                username = username,
                userId = tonumber(userId)
            })
        end
    end
    
    return alts
end

-- Check if another alt is in the current server
function hasOtherAltInServer()
    local myUserId = game.Players.LocalPlayer.UserId
    local alts = getAltAccounts()
    
    for _, player in pairs(game.Players:GetPlayers()) do
        if player.UserId ~= myUserId then
            for _, alt in ipairs(alts) do
                if player.UserId == alt.userId or player.Name == alt.username then
                    return true, player
                end
            end
        end
    end
    
    return false, nil
end

