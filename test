function addAccount()
    local filePath = Fname .. "/accounts"
    local data={
        ["Username"] = game.Players.LocalPlayer.Name,
        ["UserID"] = game.Players.LocalPlayer.UserId,
        ["Hopping"] = false
    }

    parsed = "{\n'Username': '"..data.Username.."',\n'UserID': "..data.UserID..",\n'Hopping': "..tostring(data.Hopping).."\n}"

    if readfile(filePath) == "" then
        writefile(filePath, parsed)
    else
        local existingData = readfile(filePath)
        writefile(filePath, existingData .. ",\n" .. parsed)
    end
end

function accountExist()
    local filePath = Fname .. "/accounts"
    local existingData = readfile(filePath)
    local username = game.Players.LocalPlayer.Name
    local userId = game.Players.LocalPlayer.UserId

    -- Look for both values anywhere in the file
    if existingData:find("'Username': '" .. username .. "'") 
       and existingData:find("'UserID': " .. userId) then
        return true
    end
    return false
end

-- 1 = Username
-- 2 = UserID
-- 3 = Hopping
function getAccountValue(item)
    local filePath = Fname .. "/accounts"
    local existingData = readfile(filePath)
    local username = game.Players.LocalPlayer.Name
    local userId = game.Players.LocalPlayer.UserId

    -- Iterate through each account block
    for block in existingData:gmatch("{(.-)}") do
        local accUsername = block:match("'Username':%s+'(.-)'")
        local accUserId   = block:match("'UserID':%s+(%d+)")
        local accHopping  = block:match("'Hopping':%s+(%a+)")

        if accUsername == username and tonumber(accUserId) == userId then
            if item == 1 then
                return accUsername
            elseif item == 2 then
                return tonumber(accUserId)
            elseif item == 3 then
                return accHopping == "true"
            end
        end
    end

    return nil -- not found
end

-- 1 = Username
-- 2 = UserID
-- 3 = Hopping
function writeAccountValue(item, newValue)
    local filePath = Fname .. "/accounts"
    local existingData = readfile(filePath)
    local username = game.Players.LocalPlayer.Name
    local userId = game.Players.LocalPlayer.UserId

    local updatedData = existingData:gsub("{(.-)}", function(block)
        local accUsername = block:match("'Username':%s+'(.-)'")
        local accUserId   = block:match("'UserID':%s+(%d+)")
        local accHopping  = block:match("'Hopping':%s+(%a+)")

        if accUsername == username and tonumber(accUserId) == userId then
            if item == 1 then
                block = block:gsub("'Username':%s+'.-'", "'Username': '" .. newValue .. "'")
            elseif item == 2 then
                block = block:gsub("'UserID':%s+%d+", "'UserID': " .. tostring(newValue))
            elseif item == 3 then
                local boolStr = newValue and "true" or "false"
                block = block:gsub("'Hopping':%s+%a+", "'Hopping': " .. boolStr)
            end
        end
        return "{" .. block .. "}"
    end)

    writefile(filePath, updatedData)
end


