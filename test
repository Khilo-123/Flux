local staffCache = {}  -- cache roles per player

function checkStaff(plr)
    -- already checked?
    if staffCache[plr] ~= nil then
        return staffCache[plr]
    end

    local role = nil

    -- SAFE: only call once per player
    local ok, new_role = pcall(function()
        return plr:GetRoleInGroup(10604500)
    end)

    if ok and new_role ~= "Guest" and new_role ~= "Member" and new_role ~= "Members" then
        role = new_role
    end

    -- fallback manual staff list
    if not role then
        local id = plr.UserId
        local staffIds = {
            [163721789] = true,
            [93101606] = true,
            [439942262] = true,
            [29242182] = true,
            [1830168970] = true,
            [2371804259] = true
        }

        if staffIds[id] then
            role = "admin"
        end
    end

    -- cache result
    staffCache[plr] = role or false

    -- handle detection
    if role and antistaffEnabled then
        if antistaffmode == "Notify" then
            notife({Text="Staff Detected! Roled as "..role,state=4})
        elseif antistaffmode == "Kick" then
            LocalPlayerData.plr:Kick("Staff Detected! Roled as "..role)
        elseif antistaffmode == "Stop Farming" then
            stop(hum)
        elseif antistaffmode == "Hop" then
            autoHopPlayer(true, farming)
        end

        if ondetectedsendwebhook then
            if webhookEnabled then
                local data = {
    embeds = {
        {
            title = "# Staff Detected",
            description =
                "Staff: "..plr.Name.."\n"
                .."Roled as: "..role.."\n"
                .."Option Token: "..antistaffmode,
            color = 0x00A2FF
        }
    }
}

