lastATMs = 0

function sendWebhook()
    -- Guard: bail early if there's no webhook configured
    if not webhookLink or webhookLink == "" then
        canSendWebhook = true
        return
    end

    -- Guard: DataFolder may not exist yet
    local dataFolder = LocalPlayerData.plr:FindFirstChild("DataFolder")
    local currency = dataFolder and dataFolder:FindFirstChild("Currency")
    if not currency then
        canSendWebhook = true
        return
    end

    -- Pick the best HTTP request function available
    local requestFunc = syn and syn.request
        or http and http.request
        or http_request
        or request

    if not requestFunc then
        canSendWebhook = true
        return
    end

    lastProfit = lastProfit or 0
    lastATMs   = lastATMs or 0

    local profitDiff = Profit - lastProfit
    local atmDiff    = ATMsBroken - lastATMs

    LocalPlayerData.Wallet = currency.Value

    local formattedWallet     = tostring(LocalPlayerData.Wallet):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local formattedProfit     = tostring(profitDiff):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local formattedFullProfit = tostring(Profit):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")

    local formattedLettuce  = tostring(lettuceEaten):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local formattedWeights  = tostring(weightsPulled):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local formattedPaunches = tostring(totalPaunches):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")

    local hours   = math.floor(timePassed / 3600)
    local minutes = math.floor((timePassed % 3600) / 60)
    local seconds = math.floor(timePassed % 60)

    local col1 = pad("Wallet", 12)
    local col2
    local col3 = pad("Time", 12)
    local col4 = pad("ATMs", 6)

    if currentTargetType("DHC") then
        col2 = pad("Profit", 12)
    elseif currentTargetType("Lettuce") then
        col2 = pad("Lettuce Consumed", 12)
    elseif currentTargetType("Weights") then
        col2 = pad("Weights Pulled", 12)
    elseif currentTargetType("Bags") then
        col2 = pad("Paunches", 12)
    else
        col2 = pad("Profit", 12)
    end

    local row1 = col1 .. col2 .. col3 .. col4

    local col1v = pad(formattedWallet, 12)
    local col2v
    local col3v = pad(hours .. "h" .. minutes .. "m" .. seconds .. "s", 12)
    local col4v = pad(tostring(atmDiff), 6)

    if currentTargetType("DHC") then
        col2v = pad(formattedProfit, 12)
    elseif currentTargetType("Lettuce") then
        col2v = pad(formattedLettuce, 12)
    elseif currentTargetType("Weights") then
        col2v = pad(formattedWeights, 12)
    elseif currentTargetType("Bags") then
        col2v = pad(formattedPaunches, 12)
    else
        col2v = pad(formattedProfit, 12)
    end

    local row2 = col1v .. col2v .. col3v .. col4v

    local col1x = pad("Full Profit:", 16)
    local col2x = pad("All ATMs:", 12)
    local row3 = col1x .. col2x

    local col1xv = pad(formattedFullProfit, 17)
    local col2xv = pad(tostring(ATMsBroken), 6)
    local row4  = col1xv .. col2xv

    local data = {
        embeds = {
            {
                title = "Paycheck",
                description = "**Farmbot:**\n"
                    .. "[" .. LocalPlayerData.plr.Name .. "](" .. CurrentUserProfileLink .. ")"
                    .. "\n```\n" .. row1 .. "\n" .. row2 .. "\n" .. row3 .. "\n" .. row4 .. "\n```"
                    .. "\nUtils\n"
                    .. "**[Join Server](" .. CurrentServerLink .. ")**",
                color = 0x00A2FF
            }
        }
    }

    local headers = {
        ["Content-Type"] = "application/json"
    }

    local body = game:GetService("HttpService"):JSONEncode(data)

    local ok, response = pcall(requestFunc, {
        Url     = webhookLink,
        Method  = "POST",
        Headers = headers,
        Body    = body
    })

    local statusCode = 0
    if ok and response then
        statusCode = response.StatusCode or response.Status or response.status or 0
    end

    -- Only record the diff as "sent" if Discord actually accepted it
    if ok and (statusCode == 204 or statusCode == 200) then
        lastProfit = Profit
        lastATMs   = ATMsBroken
    end

    -- Restart the cooldown regardless of success, so we don't get stuck
    canSendWebhook = false
    task.delay(interval, function()
        canSendWebhook = true
    end)

    timer = 0
end
