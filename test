    while not LocalPlayerData.plr:FindFirstChild("DataFolder") or not LocalPlayerData.plr:FindFirstChild("DataFolder"):FindFirstChild("Currency") or not LocalPlayerData.char:FindFirstChild("BodyEffects") do
