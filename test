-- Check if a server is flagged
local function isServerFlagged(serverId)
    local flagged = getFlaggedServers()
    return flagged[serverId] ~= nil
end

-- Add a server to flagged list with timestamp
local function flagServer(id)
    local currentTime = os.time()
    local dateString = os.date("%m/%d/%Y %I:%M:%S %p", currentTime)
    -- Format: serverId|timestamp|date
    appendfile(flaggedFile, id .. "|" .. tostring(currentTime) .. "|" .. dateString .. "\n")
    --("🚩 Flagged server: " .. id .. " at " .. dateString)
end

-- Clear flagged servers with timestamp
local function clearFlaggedServers()
    local currentTime = os.time()
    local dateString = os.date("%m/%d/%Y %I:%M:%S %p", currentTime)
    
    -- Write header with clear time
    writefile(flaggedFile, "=== Flagged Servers (Last cleared: " .. dateString .. "|" .. tostring(currentTime) .. ") ===\n")
    --("🗑️ Flagged servers cleared at: " .. dateString)
end

local function getFlaggedServers()
    local content = readfile(flaggedFile)
    local list = {}
    local lastCleared = 0
    
    for line in content:gmatch("[^\r\n]+") do
        -- Check header for clear time
        if line:match("^===") then
            local timestamp = line:match("%|(%d+)%) ===")
            if timestamp then
                lastCleared = tonumber(timestamp) or 0
            end
        else
            -- Format: serverId|timestamp|date
            local serverId, timestamp, date = line:match("([^|]+)|([^|]+)|(.+)")
            if serverId then
                list[serverId] = {
                    timestamp = tonumber(timestamp) or 0,
                    date = date or "Unknown"
                }
            end
        end
    end
    
    -- Check if 5 minutes have passed since last clear
    local currentTime = os.time()
    if lastCleared > 0 and (currentTime - lastCleared) >= 300 then -- 5 minutes = 300 seconds
        --("🗑️ Flagged servers expired (5 minutes passed), clearing...")
        clearFlaggedServers()
        return {} -- Return empty list since we cleared it
    end
    
    return list
end
